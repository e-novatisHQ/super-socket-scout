{
  "schemaVersion": 1,
  "runtime": "node>=20.17.0",
  "entrypoint": "src/cli.mjs",
  "goExecutable": {
    "runtime": "go>=1.24",
    "entrypoint": "cmd/server-watch",
    "binary": "server-watch"
  },
  "orchestrator": "src/orchestrator.mjs",
  "domainAdapter": "src/domain/server-adapter.mjs",
  "interactive": true,
  "nonInteractiveOptions": ["status", "check", "history", "run", "stop", "completion", "--port", "--server", "--all", "--yes", "--confirm", "--include-system", "--sudo", "--json", "--version"],
  "destructiveConfirmation": true,
  "exitCodes": { "success": 0, "technicalError": 1, "conflict": 2, "invalidInput": 3, "confirmationRequired": 4, "cancelled": 130 },
  "tests": ["test/linux-adapter.test.mjs", "test/orchestrator.test.mjs", "test/terminal-ui.test.mjs", "test/view-model.test.mjs", "test/cli.test.mjs"]
}
